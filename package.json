{
  "name": "ohttp-gateway",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "mkdir -p dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "node --experimental-strip-types src/server.ts",
    "keygen": "node --experimental-strip-types scripts/keygen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts",
    "format": "biome format --write src test scripts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@panva/hpke-noble": "^1.1.2",
    "hono": "^4.12.8",
    "hpke": "^1.1.2",
    "ohttp-ts": "^0.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^25.9.3",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.0.0"
  }
}
