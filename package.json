{
  "name": "ohttp-gateway",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "mkdir -p dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "node --experimental-strip-types src/server.ts",
    "keygen": "node --experimental-strip-types scripts/keygen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts",
    "format": "biome format --write src test scripts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@panva/hpke-noble": "^1.1.2",
    "hono": "^4.12.25",
    "hpke": "^1.1.2",
    "ohttp-ts": "^0.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/workers-types": "^5.20260703.1",
    "@types/node": "^26.1.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  }
}
