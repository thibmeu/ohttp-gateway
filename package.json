{
  "name": "ohttp-gateway",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "build": "mkdir -p dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "node --experimental-strip-types src/server.ts",
    "keygen": "node --experimental-strip-types scripts/keygen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts api netlify",
    "format": "biome format --write src test scripts api netlify"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@panva/hpke-noble": "^1.1.9",
    "hono": "^4.13.21",
    "hpke": "^1.1.10",
    "ohttp-ts": "^0.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/vitest-plugin": "^1.9.1",
    "@cloudflare/workers-types": "^5.20261124.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  }
}
