{
  "name": "ohttp-gateway",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "mkdir -p dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "node --experimental-strip-types src/server.ts",
    "keygen": "node --experimental-strip-types scripts/keygen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts api netlify",
    "format": "biome format --write src test scripts api netlify"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@panva/hpke-noble": "^1.1.4",
    "hono": "^4.13.3",
    "hpke": "^1.1.2",
    "ohttp-ts": "^0.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
